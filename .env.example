# Copy to .env on the server only. Never commit the real .env.
# Host/runtime values used by the existing Compose stack
DOCKER=
PUID=
PGID=
TZ=

# Sonarr (Compose maps SONARR_APIKEY to the container's SONARR_API_KEY)
SONARR_APIKEY=

# Optional integrations
TMDB_APIKEY=
DEEPL_APIKEY=
TVDB_USER=
TVDB_PASSWORD=

# Generate once on the server, keep stable, and never commit or share the value.
METADATARR_SECRET_KEY=
